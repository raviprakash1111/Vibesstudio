# VIBES STUDIO — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env in production server environment. Do NOT commit production secrets to Git.

# Database Connection (PostgreSQL / MySQL / Managed DB)
DATABASE_URL="postgresql://vibes_user:production_password@localhost:5432/vibesstudio_db"

# Admin Authentication Secret (Session JWT Key)
AUTH_SECRET="vibes_studio_super_secret_jwt_session_key_2026"

# Media Storage Provider (S3 / CDN Bucket URL)
STORAGE_URL="https://cdn.vibesstudio.com/uploads"

# Official Studio WhatsApp Number (Country Code + 10 Digits)
WHATSAPP_NUMBER="919876543210"

# Google Analytics / GTM Tracking ID
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Google Maps Directions URL
GOOGLE_MAPS_URL="https://maps.google.com/?q=Aganampudi,Visakhapatnam,Andhra+Pradesh"
